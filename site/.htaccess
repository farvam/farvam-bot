# آدرس‌های تمیز برای مقاله‌ها و نقشه سایت (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^blog/?$ blog/index.php [L]
  RewriteRule ^blog/([a-z0-9\-]+)/?$ blog/article.php?slug=$1 [L,QSA]
  RewriteRule ^for/([a-z]+)/?$ for.php?role=$1 [L,QSA]
  RewriteRule ^present/?$ present.php [L,QSA]
</IfModule>
# فشرده‌سازی و کش برای سرعت (اثر مستقیم روی سئو)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
<FilesMatch "^(config|lib|build-static)\.php$">
  Require all denied
</FilesMatch>
